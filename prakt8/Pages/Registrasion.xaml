<Page x:Class="prakt8.Pages.Registrasion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Registrasion" Background="{DynamicResource WindowBackground}">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Margin="30" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <TextBlock Text="Регистрация врача" Style="{StaticResource PageTitle}"/>

            <TextBlock Text="Фамилия:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding LastName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Имя:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding FirstName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Отчество:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding MiddleName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Специальность:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Specialty}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Пароль:" Style="{StaticResource Label}"/>
            <TextBox x:Name="PasswordTextBox" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Подтверждение пароля:" Style="{StaticResource Label}"/>
            <TextBox x:Name="ConfirmPasswordTextBox" Style="{StaticResource TextInput}" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Зарегистрироваться" Style="{StaticResource SuccessButton}" Click="RegisterButton_Click" Margin="0,0,10,0"/>
                <Button Content="Назад" Style="{StaticResource PrimaryButton}" Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
