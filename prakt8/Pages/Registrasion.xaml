<Page x:Class="prakt8.Pages.Registrasion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Registrasion">

    <Grid Background="White">
        <StackPanel Margin="30" >
            <TextBlock Text="Регистрация врача" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Фамилия:"/>
            <TextBox Text="{Binding LastName}" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Имя:"/>
            <TextBox Text="{Binding FirstName}" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Отчество:"/>
            <TextBox Text="{Binding MiddleName}" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Специальность:"/>
            <TextBox Text="{Binding Specialty}" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Пароль:"/>
            <TextBox x:Name="PasswordTextBox" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Подтверждение пароля:"/>
            <TextBox x:Name="ConfirmPasswordTextBox" Height="25" Margin="0,5,0,20"/>

            <Button Content="Зарегистрироваться" Click="RegisterButton_Click" Height="30" Margin="0,0,0,10"/>
            <Button Content="Назад" Click="BackButton_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Page>
