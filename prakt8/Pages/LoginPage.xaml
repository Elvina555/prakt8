<Page x:Class="prakt8.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">
    <Grid Background="White">
        <StackPanel Margin="50" VerticalAlignment="Center">

            <TextBlock Text="Вход в систему" 
                   FontSize="20" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"/>

            <TextBlock Text="ID врача:" Margin="0,5"/>
            <TextBox x:Name="IdTextBox" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" Margin="0,5"/>
            <TextBox x:Name="PasswordBox" Height="30" Margin="0,0,0,30"/>

            <Button Content="Войти" 
                Click="LoginButton_Click" 
                Height="35" 
                Margin="0,0,0,10"/>

            <Button Content="Регистрация" 
                Click="RegisterButton_Click" 
                Height="35"/>

        </StackPanel>
    </Grid>
</Page>
