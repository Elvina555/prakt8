<Page x:Class="prakt8.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
     Title="LoginPage" Background="{DynamicResource WindowBackground}">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Style="{DynamicResource FormContainer}">
            <TextBlock Text="Вход в систему" Style="{DynamicResource PageTitle}"/>

            <TextBlock Text="ID врача:" Style="{DynamicResource Label}"/>
            <TextBox x:Name="IdTextBox" Style="{DynamicResource TextInput}"/>

            <TextBlock Text="Пароль:" Style="{DynamicResource Label}"/>
            <TextBox x:Name="PasswordBox" Style="{DynamicResource TextInput}"/>

            <StackPanel Style="{DynamicResource ButtonPanel}">
                <Button Content="Войти" Style="{DynamicResource PrimaryButton}" Click="LoginButton_Click"/>
                <Button Content="Регистрация" Style="{DynamicResource PrimaryButton}" Click="RegisterButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </Page>
