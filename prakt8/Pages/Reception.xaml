<Page x:Class="prakt8.Pages.Reception"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Reception">

    <Grid Background="White" >
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="Прием пациента" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="PatientInfoText" FontSize="16" />

            <TextBlock Text="Диагноз:" />
            <TextBox Text="{Binding Diagnosis}" Height="56" Width="746"/>

            <TextBlock Text="Рекомендации:"/>
            <TextBox Text="{Binding Recommendations}" Width="743" Height="148"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить прием" Click="SaveAppointmentButton_Click" Margin="5" Padding="10,5"/>
                <Button Content="Изменить информацию" Click="EditPatientButton_Click" Margin="5" Padding="10,5"/>
                <Button Content="Назад" Click="BackButton_Click" Margin="5" Padding="10,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
