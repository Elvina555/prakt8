<Page x:Class="prakt8.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage" Background="{DynamicResource WindowBackground}">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Margin="30">
            <TextBlock x:Name="DoctorInfoText" Style="{DynamicResource SectionTitle}"/>

            <StackPanel Style="{DynamicResource ButtonPanel}">
                <Button Content="Создать пациента" Style="{DynamicResource SuccessButton}" Click="CreatePatientButton_Click"/>
                <Button Content="Начать прием" Style="{DynamicResource PrimaryButton}" Click="StartAppointmentButton_Click"/>
                <Button Content="Изменить информацию" Style="{DynamicResource PrimaryButton}" Click="EditPatientButton_Click"/>
                <Button Content="Удалить пациента" Style="{DynamicResource DangerButton}" Click="DeletePatientButton_Click"/>
                <Button Content="Выйти" Style="{DynamicResource PrimaryButton}" Click="LogoutButton_Click"/>
            </StackPanel>
            <TextBlock Text="Список пациентов:" Style="{DynamicResource SectionTitle}"/>
            <ListView x:Name="PatientsListView" Style="{DynamicResource DataGrid}" 
                      SelectionChanged="PatientsListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BirthDate, StringFormat='Дата рождения: {0:dd.MM.yyyy}'}"/>
                            <TextBlock Text="{Binding Diagnosis, StringFormat='Диагноз: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="StatusText" Style="{DynamicResource Label}" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>