<Page x:Class="prakt8.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid Background="White">
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock x:Name="DoctorInfoText" FontSize="14" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Создать пациента" Click="CreatePatientButton_Click" Margin="5" Padding="10,5"/>
                <Button Content="Начать прием" Click="StartAppointmentButton_Click" Margin="5" Padding="10,5"/>
                <Button Content="Изменить информацию" Click="EditPatientButton_Click" Margin="5" Padding="10,5"/>
                <Button Content="Выйти" Click="LogoutButton_Click" Margin="5" Padding="10,5"/>
            </StackPanel>

            <ListView x:Name="PatientsListView" Height="300" SelectionChanged="PatientsListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Id}"/>
                            <TextBlock Text="{Binding LastName}"/>
                            <TextBlock Text="{Binding FirstName}"/>
                            <TextBlock Text="{Binding MiddleName}"/>
                            <TextBlock Text="{Binding BirthDate}"/>
                            <TextBlock Text="{Binding Diagnosis}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
