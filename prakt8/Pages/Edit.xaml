<Page x:Class="prakt8.Pages.Edit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
           Title="Edit" Background="{DynamicResource WindowBackground}">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Margin="30" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <TextBlock Text="Изменение информации о пациенте" Style="{StaticResource PageTitle}"/>

            <TextBlock Text="Фамилия:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding LastName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Имя:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding FirstName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Отчество:" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding MiddleName}" Style="{StaticResource TextInput}"/>

            <TextBlock Text="Дата рождения:" Style="{StaticResource Label}"/>
            <DatePicker SelectedDate="{Binding BirthDate}" Style="{StaticResource DatePickerStyle}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Style="{StaticResource SuccessButton}" Click="SaveButton_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Style="{StaticResource PrimaryButton}" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</Page>
