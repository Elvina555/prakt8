<Page x:Class="prakt8.Pages.CreatePatient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreatePatient" Background="{DynamicResource WindowBackground}">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Style="{DynamicResource FormContainer}">
            <TextBlock Text="Создание пациента" Style="{DynamicResource PageTitle}"/>

            <TextBlock Text="Фамилия:" Style="{DynamicResource Label}"/>
            <TextBox x:Name="LastNameTextBox" Text="{Binding LastName}" Style="{DynamicResource TextInput}"/>

            <TextBlock Text="Имя:" Style="{DynamicResource Label}"/>
            <TextBox x:Name="FirstNameTextBox" Text="{Binding FirstName}" Style="{DynamicResource TextInput}"/>

            <TextBlock Text="Отчество:" Style="{DynamicResource Label}"/>
            <TextBox x:Name="MiddleNameTextBox" Text="{Binding MiddleName}" Style="{DynamicResource TextInput}"/>

            <TextBlock Text="Дата рождения:" Style="{DynamicResource Label}"/>
            <DatePicker x:Name="BirthDatePicker" SelectedDate="{Binding BirthDate}" Style="{DynamicResource DatePickerStyle}"/>

            <StackPanel Style="{DynamicResource ButtonPanel}">
                <Button Content="Сохранить" Style="{DynamicResource SuccessButton}" Click="SaveButton_Click"/>
                <Button Content="Отмена" Style="{DynamicResource PrimaryButton}" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
